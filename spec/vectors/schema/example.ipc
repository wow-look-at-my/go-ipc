# Conformance schema. Every language round-trips values.json through it.
package demo

# Every scalar. The order forces padding before f_u64, f_i16, f_i32, f_f64 and f_i64.
message Scalars = 1 {
	f_bool bool
	f_u64 u64
	f_i8 i8
	f_i16 i16
	f_u8 u8
	f_i32 i32
	f_u16 u16
	f_f64 f64
	f_u32 u32
	f_f32 f32
	f_i64 i64
}

message Vec2 = 2 {
	x f32
	y f32
}

# Nested messages, arrays of scalars and of messages, and a field type declared later.
message Shape = 3 {
	kind u8
	origin Vec2
	corners [3]Vec2
	flags [3]bool
	weights [2]f64
	limits Padded
	codes [5]i16
}

# Tail padding: the section rounds up to the 8-byte alignment.
message Padded = 4 {
	big u64
	small u8
}

# Fixed fields with padding, then a variable tail.
message Record = 5 {
	id u64
	pos Vec2
	tags [4]u16
	ok bool
	label string
	blob bytes
}

# Only variable fields: the fixed section is empty.
message Text = 6 {
	title string
	data bytes
	note string
}

# No fields at all.
message Empty = 7 {
}

# An empty message as a field and as an array element.
message Holder = 8 {
	before u8
	nothing Empty
	many [2]Empty
	after u16
}

# A one-byte fixed section, so the tail starts at an odd offset with no padding.
message Tagged = 0xFFFFFFFE {
	level i8
	name string
}
